PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/workpilot?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173

# ─── PRODUCTION NOTES ────────────────────────────────────────────────────────
# CLIENT_URL: Set to your Vercel deployment URL (e.g. https://workpod.vercel.app)
#             Supports comma-separated values for multiple origins:
#             CLIENT_URL=https://workpod.vercel.app,https://workpod-git-main.vercel.app

# ─── LLM Configuration ──────────────────────────────────────────────────────
# CascadeFlow is used as an in-process harness for cost tracking / observability.
# No URL config needed — just install @cascadeflow/core and it works automatically.
LLM_MODEL=openai/gpt-oss-120b

# ─── Groq API Key ──────────────────────────────────────────────────────────
# Single Groq API key for all LLM calls.
GROQ_API_KEY=your_groq_api_key_here

# ─── Hindsight Memory ───────────────────────────────────────────────────────
# Long-term memory per user per role. Self-host via Docker or use cloud.
# For cloud: sign up at vectorize.io, get your URL and API key.
# For local Docker: just set the base URL, no API key needed.
# NOTE: If not using Hindsight, leave these empty — the app works without it.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
