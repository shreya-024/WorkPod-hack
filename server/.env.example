PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/workpilot?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_here
CLIENT_URL=http://localhost:5173

# ─── LLM Configuration ──────────────────────────────────────────────────────
# CascadeFlow is used as an in-process harness for cost tracking / observability.
# No URL config needed — just install @cascadeflow/core and it works automatically.
LLM_MODEL=llama-3.3-70b-versatile

# ─── Groq API Keys ──────────────────────────────────────────────────────────
# Supply multiple keys for automatic round-robin rotation and quota failover.
# The service reads these env vars in order; any that are set will be used.
# If none of the numbered keys are set, it falls back to GROQ_API_KEY.
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=

# ─── Hindsight Memory ───────────────────────────────────────────────────────
# Long-term memory per user per role. Self-host via Docker or use cloud.
# For cloud: sign up at vectorize.io, get your URL and API key.
# For local Docker: just set the base URL, no API key needed.
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
